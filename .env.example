# ------------------------------------------------------------------
# Slotter environment. Copy this file to .env.local and fill it in.
#   cp .env.example .env.local
# ------------------------------------------------------------------

# demo  = no email, no real payments, built-in test checkout page. Great for local dev.
# prod  = sends real email (Resend) and takes real deposits (each tenant's own Stripe).
APP_MODE=demo

# Edition: 'agency' (default) = white-label multi-tenant hub, no public signup.
#          'market' = self-serve product with public signup + marketing landing.
# See docs/EDITIONS.md.
SLOTTER_EDITION=agency

# ---- Database (Supabase) ------------------------------------------
# From your Supabase project: Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# App-key secret. Any long random string. It gates every database call and
# MUST equal the value you put in db/schema.sql (replace REPLACE_WITH_BH_API_KEY there).
# Generate one:  openssl rand -hex 32
BH_API_KEY=change-me-to-a-long-random-string

# Signs owner login sessions + hashes login codes. Any long random string.
# Generate one:  openssl rand -hex 32
APP_SECRET=change-me-to-another-long-random-string

# Public base URL of this app (used in emails, embed snippets, calendar links).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated emails allowed into the /admin support console. Optional.
ADMIN_EMAILS=admin@slotter.local

# Optional: BCC every owner notification to an ops inbox (handy if one agency runs many tenants).
# OWNER_NOTICE_BCC=ops@youragency.com

# Optional: protects the reminder cron endpoint. Vercel Cron is trusted automatically;
# set this if you also want to trigger /api/cron/reminders manually. openssl rand -hex 16
# CRON_SECRET=change-me

# Optional: error alerts. Any JSON endpoint (a Slack incoming webhook works out of the box).
# Health probe is always available at /api/health. For full Sentry, add @sentry/nextjs.
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ---- Branding (all optional — defaults shown) ---------------------
# The product name shown in the UI and outgoing email.
NEXT_PUBLIC_APP_NAME=Slotter
# Domain used for calendar invite UIDs and the "organizer" address on .ics files.
APP_ICS_DOMAIN=slotter.local
# Set to "true" to hide the small "scheduling by Slotter" line in the booking footer.
# NEXT_PUBLIC_HIDE_ATTRIBUTION=false

# ---- Email (required only when APP_MODE=prod) ---------------------
# Resend API key + a verified From address on your domain.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=bookings@yourdomain.com

# ---- Calendar sync (optional; prod two-way sync) ------------------
# Two-way sync (read the owner's busy times + push bookings) works in DEMO with no keys.
# For real Google/Outlook sync in production, create OAuth apps and set these.
# Google Cloud Console → OAuth client (Web). Redirect URI: <BASE>/api/calendar/callback?provider=google
# GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxxx
# Microsoft Entra app registration. Redirect URI: <BASE>/api/calendar/callback?provider=microsoft
# MS_OAUTH_CLIENT_ID=xxxx
# MS_OAUTH_CLIENT_SECRET=xxxx
# MS_OAUTH_TENANT=common   # or your Entra tenant id
# Zoom (optional; B1 Layer B — real Zoom meetings on video bookings, preferred over Meet/Teams
# when the owner connects Zoom). Zoom Marketplace → General App (user-managed).
# Redirect URI: <BASE>/api/zoom/callback  ·  Scopes: meeting:write:meeting, meeting:delete:meeting, user:read:user
# ZOOM_CLIENT_ID=xxxx
# ZOOM_CLIENT_SECRET=xxxx

# ---- SMS (optional; prod text confirmations + reminders) ----------
# SMS works in DEMO (lands in /demo/outbox) with no keys. For real texts in production,
# set all three from your Twilio account. Leave unset to keep SMS off.
#
# ⚠️ THIS IS ONE SHARED SENDER FOR THE WHOLE DEPLOYMENT. If you host more than one
# business on this hub, EVERY business's customers get texts from this single number,
# under this single Twilio account + A2P registration (shared branding, reputation, and
# STOP opt-out list). That's fine for a single business. To give a business its OWN
# number instead, leave these unset (or keep as a fallback) and store that business's
# Twilio creds per-tenant in the bh_tenant_sms table — see docs/SMS.md. Your AI can wire
# this up for you; AGENTS.md → "Per-business SMS numbers" has the exact steps.
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_FROM=+15551234567

# ---- Market-edition billing (optional; charge business owners) -----
# Only the market edition bills owners. Demo/unset = everyone is on a working free plan and
# "Upgrade" flips the plan with no charge. To charge for real, set SLOTTER_BILLING=stripe plus
# your PLATFORM Stripe keys (this is separate from each tenant's own deposit Stripe).
# SLOTTER_BILLING=stripe
# STRIPE_PLATFORM_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...                # your Pro subscription price
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_...  # endpoint: <BASE>/api/billing/webhook

# ---- Payments (prod deposits) -------------------------------------
# Stripe keys are NOT set here. Each tenant stores their OWN Stripe keys in the
# bh_tenant_payments table so deposits land in the tenant's account and this app
# never touches card data. See README → "Paid bookings".
